<h1> My Blog Posts </h1>

<% @blog_posts.each do |blog_post| %>
    <div class="blog-post">
        <h2><%= link_to blog_post.title, blog_post %></h2>
        <% if blog_post.draft? %>
            <div class="p-2 rounded bg-gray-100 text-gray-700 text-xs font-semibold mb-2">
                Draft
            </div>
        <% elsif blog_post.scheduled? %>
            <div class="p-2 rounded bg-blue-100 text-blue-700 text-xs font-semibold mb-2">
                Scheduled
            </div>
        <% end %>
        <p><%= blog_post.content  %></p>
    </div>
<% end %>

